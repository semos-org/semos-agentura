# === Mapped network drive (preferred — no OAuth needed) ===
SHAREPOINT_DRIVE_PATH=T:\Documents

# === SharePoint site info ===
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/MySite
SHAREPOINT_DOC_LIBRARY=Freigegebene Dokumente
SHAREPOINT_SUBFOLDER=General

# === Azure AD / Entra ID (only needed for programmatic WebDAV access) ===
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
