# Base image for all Semos Agentura agents
# Python 3.13 + uv + workspace sync (shared dependencies)
FROM python:3.13-slim AS base

# System deps shared by all agents
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy workspace root config first (for caching)
COPY pyproject.toml uv.lock .python-version ./

# Copy all package pyproject.toml files (for dependency resolution)
COPY packages/semos-agentura-core/pyproject.toml packages/semos-agentura-core/pyproject.toml
COPY packages/semos-agentura-email/pyproject.toml packages/semos-agentura-email/pyproject.toml
COPY packages/semos-agentura-document/pyproject.toml packages/semos-agentura-document/pyproject.toml
COPY packages/semos-agentura-files/pyproject.toml packages/semos-agentura-files/pyproject.toml
COPY packages/semos-agentura-ui/pyproject.toml packages/semos-agentura-ui/pyproject.toml
COPY packages/semos-agentura/pyproject.toml packages/semos-agentura/pyproject.toml

# Copy READMEs (required by hatchling build backend)
COPY packages/semos-agentura-core/README.md packages/semos-agentura-core/README.md
COPY packages/semos-agentura-email/README.md packages/semos-agentura-email/README.md
COPY packages/semos-agentura-document/README.md packages/semos-agentura-document/README.md
COPY packages/semos-agentura-files/README.md packages/semos-agentura-files/README.md
COPY packages/semos-agentura-ui/README.md packages/semos-agentura-ui/README.md
COPY packages/semos-agentura/README.md packages/semos-agentura/README.md

# Copy source code
COPY packages/semos-agentura-core/src/ packages/semos-agentura-core/src/
COPY packages/semos-agentura-email/src/ packages/semos-agentura-email/src/
COPY packages/semos-agentura-document/src/ packages/semos-agentura-document/src/
COPY packages/semos-agentura-files/src/ packages/semos-agentura-files/src/
COPY packages/semos-agentura-ui/src/ packages/semos-agentura-ui/src/

# Sync all workspace packages
RUN uv sync --all-packages --no-dev --frozen
