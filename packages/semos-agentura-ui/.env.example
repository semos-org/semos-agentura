# Azure AI Foundry (Anthropic endpoint)
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource.services.ai.azure.com/anthropic

# Agent endpoints (defaults shown)
SEMOS_AGENTURA_EMAIL_URL=http://localhost:8001/mcp/sse
SEMOS_AGENTURA_DOCUMENT_URL=http://localhost:8002/mcp/sse
SEMOS_AGENTURA_EMAIL_BASE=http://localhost:8001
SEMOS_AGENTURA_DOCUMENT_BASE=http://localhost:8002
SEMOS_AGENTURA_FILES_URL=http://localhost:8003/mcp/sse
SEMOS_AGENTURA_FILES_BASE=http://localhost:8003

# Protocol selection: mcp (default) or a2a
DEFAULT_PROTOCOL=mcp

