# Filesystem Agent Configuration
# Copy to .env and fill in values as needed.

# Agent server
# AGENT_HOST=127.0.0.1
# AGENT_PORT=8003

# SharePoint / OneDrive (browser-based cookie auth, no setup needed)
# Used by search_sharepoint tool when no root is mounted
# SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/MySite
# SHAREPOINT_DOC_LIBRARY=Shared Documents
# SHAREPOINT_SUBFOLDER=General

# Azure AD app credentials (alternative to browser auth for SharePoint)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Google Drive (OAuth2 - requires GCP project)
# 1. Create project at https://console.cloud.google.com
# 2. Enable "Google Drive API"
# 3. Create OAuth consent screen (External, add test users)
# 4. Create OAuth client ID (Desktop app)
# GOOGLE_DRIVE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_DRIVE_CLIENT_SECRET=GOCSPX-xxxxx

# Integration test URLs (not committed, set locally)
# TEST_SHAREPOINT_SITE_URL=https://org.sharepoint.com/sites/TestSite
# TEST_SHAREPOINT_DOC_LIBRARY=Shared Documents
# TEST_SHAREPOINT_SUBFOLDER=General
# TEST_ONEDRIVE_SHARING_FOLDER_LINK=https://tenant-my.sharepoint.com/:f:/g/personal/...
# TEST_ONEDRIVE_SHARING_FILE_LINK=https://tenant-my.sharepoint.com/:w:/g/personal/...
# TEST_GOOGLE_DRIVE_FOLDER_LINK=https://drive.google.com/drive/folders/ID?usp=sharing
# TEST_GOOGLE_DRIVE_FILE_LINK=https://drive.google.com/file/d/ID/view?usp=sharing
# TEST_GOOGLE_DRIVE_DOC_LINK=https://docs.google.com/document/d/ID/edit?usp=sharing
